---
interface Props {
  id: string;
  number: number;
  title: string;
  canvasSize?: number;
  pixelated?: boolean;
  withInset?: boolean;
}

const { id, number, title, canvasSize = 480, pixelated = false, withInset = false } = Astro.props;
---

<section class="stage" id={id} data-stage={id}>
  <div class="stage-canvas-wrap">
    <canvas
      class:list={["stage-canvas", pixelated && "stage-canvas-pixelated"]}
      data-canvas
      width={canvasSize}
      height={canvasSize}
    ></canvas>
    {
      withInset && (
        <div class="stage-inset">
          <p class="stage-inset-label">Camera view</p>
          <canvas class="stage-inset-canvas" data-canvas-inset width="160" height="160" />
        </div>
      )
    }
  </div>
  <div class="stage-hud">
    <p class="stage-number">Stage {number} of 6</p>
    <h2>{title}</h2>
    <div class="stage-body">
      <slot />
    </div>
  </div>
</section>
