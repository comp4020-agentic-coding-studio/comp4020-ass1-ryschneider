---
import Layout from "../layouts/Layout.astro";
import RangeControl from "../components/RangeControl.astro";
import StageSection from "../components/StageSection.astro";
import ToggleControl from "../components/ToggleControl.astro";
---

<Layout title="How a rasterized render pipeline works — COMP4020 prototype">
  <nav class="stage-rail" aria-label="Stages">
    <a href="#model"><span class="visually-hidden">Model space</span></a>
    <a href="#world"><span class="visually-hidden">Model to world transform</span></a>
    <a href="#view"><span class="visually-hidden">World to view transform</span></a>
    <a href="#projection"><span class="visually-hidden">Projection and field of view</span></a>
    <a href="#rasterize"><span class="visually-hidden">Rasterization</span></a>
    <a href="#shading"><span class="visually-hidden">Shading</span></a>
  </nav>
  <main>
    <section class="title-card">
      <h1>How a rasterized render pipeline works</h1>
      <p>
        Start from a single triangle and build up, stage by stage, to a lit
        low-poly sphere. Drag the scenes, drag the sliders, watch the shape
        change.
      </p>
      <p class="scroll-hint">Scroll ↓</p>
    </section>

    <StageSection id="model" number={1} title="Model space">
      <p>
        One triangle, defined by three points around its own origin — no
        transform, camera, or light touching it yet.
      </p>
    </StageSection>

    <StageSection id="world" number={2} title="Model → world transform">
      <p>
        Placing the triangle in a shared world means multiplying every vertex
        by a transform matrix: rotate it, scale it, move it across the grid.
      </p>
      <RangeControl id="world-rotation" label="Rotation" min={0} max={360} step={1} value={45} unit="°" />
      <RangeControl id="world-scale" label="Scale" min={0.5} max={2} step={0.05} value={1} />
      <RangeControl id="world-translate-x" label="Move X" min={-2} max={2} step={0.1} value={0} />
      <RangeControl id="world-translate-z" label="Move Z" min={-2} max={2} step={0.1} value={0} />
    </StageSection>

    <StageSection id="view" number={3} title="World → view (camera) transform" withInset>
      <p>
        The camera has its own position and orientation in world space. Drag
        the scene to look around it from outside; the sliders move the camera
        itself, and the inset shows exactly what it sees.
      </p>
      <RangeControl id="view-azimuth" label="Camera azimuth" min={-180} max={180} step={1} value={40} unit="°" />
      <RangeControl id="view-elevation" label="Camera elevation" min={-80} max={80} step={1} value={20} unit="°" />
      <RangeControl id="view-distance" label="Camera distance" min={1.8} max={6} step={0.1} value={3.2} />
    </StageSection>

    <StageSection id="projection" number={4} title="Projection & field of view" withInset>
      <p>
        The projection matrix maps everything inside the camera's frustum
        into clip space. Widen the field of view and watch the frustum flare
        out — and the picture it captures distort.
      </p>
      <RangeControl id="projection-fov" label="Field of view" min={20} max={120} step={1} value={55} unit="°" />
    </StageSection>

    <StageSection id="rasterize" number={5} title="Rasterization" canvasSize={160} pixelated>
      <p>
        Rasterizing means deciding which pixels a triangle's corners cover.
        Zoomed into individual pixels here — add faces to see the surface
        smooth out, or reveal the pixel grid underneath it.
      </p>
      <RangeControl
        id="rasterize-subdivisions"
        label="Mesh detail (subdivisions)"
        min={0}
        max={3}
        step={1}
        value={0}
      />
      <ToggleControl
        id="rasterize-pixel-grid-toggle"
        label="Pixel grid"
        onLabel="Grid on"
        offLabel="Grid off"
      />
    </StageSection>

    <StageSection id="shading" number={6} title="Shading: per-vertex vs per-pixel">
      <p>
        The rasterizer fills every triangle identically either way — what
        changes is <em>when</em> lighting is computed.
        <strong>Gouraud</strong> shading lights each vertex once and interpolates
        the resulting color across the triangle. <strong>Phong</strong> shading
        interpolates the surface normal instead, and lights every pixel
        individually. On a curved, low-poly surface like this one, Gouraud's
        flat-colored triangles show up as visible banding; Phong keeps
        highlights smooth.
      </p>
      <ToggleControl
        id="shading-mode-toggle"
        label="Shading mode"
        onLabel="Per-pixel (Phong)"
        offLabel="Per-vertex (Gouraud)"
      />
      <RangeControl id="shading-light-azimuth" label="Light azimuth" min={-180} max={180} step={1} value={40} unit="°" />
      <RangeControl id="shading-shininess" label="Shininess" min={2} max={128} step={1} value={28} />
    </StageSection>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
