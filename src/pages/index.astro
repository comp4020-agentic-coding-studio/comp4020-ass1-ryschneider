---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rasterizer — an OpenGL explainer">
  <div class="game-shell">
    <canvas id="game-canvas" aria-label="OpenGL viewport"></canvas>

    <header class="game-header">
      <h1>Rasterizer</h1>
      <nav class="stage-progress" aria-label="Stages"></nav>
    </header>

    <aside id="hud" class="hud" aria-label="Stage controls"></aside>

    <button id="next-stage-button" type="button" class="next-stage-button" hidden>Next stage →</button>
  </div>

  <script src="../scripts/main.ts"></script>
</Layout>
